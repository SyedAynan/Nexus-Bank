{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_RAILWAY_BACKEND.up.railway.app/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://YOUR_RAILWAY_BACKEND.up.railway.app/ws/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
